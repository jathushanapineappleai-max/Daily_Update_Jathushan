						"body": {
							"mode": "raw",
							"raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"emp_id\": \"EMP001\",\n  \"gender\": \"male\",\n  \"dob\": \"1990-01-01\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"123 Main St, City, Country\",\n  \"password\": \"securePassword123\"\n}",
